# Dependencies (npm install restores these)
node_modules/

# Upload artifact (npm run package) — keep folder via .gitkeep
DEPLOY/**
!DEPLOY/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env / secrets
.env
.env.*

# Note: src/vendor/lite/ is intentionally tracked (prebuilt Lite bake).

# Recovery / disk images (do not commit)
*.img
*.img.bz2
*.img.gz
*.iso
