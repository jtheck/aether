hurch",-98,66,0],[2,"moonwell",98,66,0],[4,"tower",-266,-18,0],[4,"tower",266,-18,0],[4,"church",2,-182,0]],"story":{"reels":[{"id":"intro","when":"start","duration":14.865,"reveal":"all","clips":[{"id":"intro-cam-0","kind":"camera","t":0,"dur":1.8,"tx":104,"tz":93,"radius":380,"alpha":-2},{"id":"intro-line-1","kind":"line","t":1.8,"dur":5.665,"text":"At the center of everything beats a dark heart. Around it, the last of the light — and the last of you."},{"id":"intro-cam-2","kind":"camera","t":7.465,"dur":2.4,"tx":104,"tz":62,"radius":110,"alpha":-1.9},{"id":"intro-line-3","kind":"line","t":9.865,"dur":2.5,"speaker":"Lady","text":"Whatever happens now, we finish it together.","style":"whisper"},{"id":"intro-line-4","kind":"line","t":12.365,"dur":2.5,"speaker":"Stumpey","text":"Together. For the heart. One last time.","style":"command"}]},{"id":"ending","when":"win","duration":12.345,"reveal":[4],"clips":[{"id":"ending-cam-0","kind":"camera","t":0,"dur":2,"tx":104,"tz":62,"radius":200,"alpha":-1.9},{"id":"ending-line-1","kind":"line","t":2,"dur":2.5,"speaker":"Doc","text":"It's... over. The dark is gone.","style":"whisper"},{"id":"ending-line-2","kind":"line","t":4.5,"dur":5.445,"text":"The heart shatters into a thousand points of light, and the world holds its breath — then breathes."},{"id":"ending-hold-3","kind":"hold","t":9.945,"dur":2.4}]}]},"obj":[[104,128,7,"survive","Hold the ring while the light gathers.","","here","e5c3o0",{"p":{"waves":8,"era":5}}],[104,58,7,"destroy","End it here. There is no next road.","","end","e5c3o1",{"t":1,"p":{"building":"church"}}]],"ncb":1,"pk":{"files":["e1c1.garden","e1c2.garden","e1c3.garden","e1c4.garden","e2c1.garden","e2c2.garden","e2c3.garden","e2c4.garden","e3c1.garden","e3c2.garden","e3c3.garden","e3c4.garden","e4c1.garden","e4c2.garden","e4c3.garden","e4c4.garden","e5c1.garden","e5c2.garden","e5c3.garden"]}}}}