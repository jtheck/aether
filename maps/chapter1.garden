:0,"dur":1.2,"tx":30,"tz":40,"radius":100,"alpha":0.3},{"id":"ending-line-1","kind":"line","t":1.2,"dur":2.5,"speaker":"Stumpey","text":"We made it...","style":"whisper"},{"id":"ending-line-2","kind":"line","t":3.7,"dur":2.5,"speaker":"Lady","text":"But look behind us...","style":"scared"},{"id":"ending-cam-3","kind":"camera","t":6.2,"dur":2.6,"tx":30,"tz":24,"radius":145,"alpha":-2.15},{"id":"ending-line-4","kind":"line","t":8.8,"dur":2.53,"speaker":"Doc","text":"All those towers... everything we built. Gone.","style":"think"},{"id":"ending-hold-5","kind":"hold","t":11.33,"dur":0.8},{"id":"ending-line-6","kind":"line","t":12.13,"dur":2.5,"speaker":"Goblin","text":"No use cryin' about it. What's ahead?"},{"id":"ending-line-7","kind":"line","t":14.63,"dur":2.5,"speaker":"Stumpey","text":"The old road. Nobody's used it in ages."},{"id":"ending-line-8","kind":"line","t":17.130000000000003,"dur":3.19,"text":"The party turns north, leaving the corrupted grove behind."},{"id":"ending-hold-9","kind":"hold","t":20.320000000000004,"dur":1.8}]}]},"obj":[[30,34,6,"escape","The old road. Nobody's used it in ages.","/maps/chapter2.garden","Reach the old road (north)","road"]],"ncb":1,"bd":[["disc",0,0,-242.96,0,80]]}