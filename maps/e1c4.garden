0,39,"Doc"],[4,2,77,25],[4,2,81,25],[4,1,79,27]],"b":[[4,"tower",30,-190,0]],"story":{"reels":[{"id":"intro","when":"start","duration":14.88,"clips":[{"id":"intro-cam-0","kind":"camera","t":0,"dur":1.8,"tx":72,"tz":40,"radius":250,"alpha":0},{"id":"intro-line-1","kind":"line","t":1.8,"dur":5.555,"text":"The only way clear is the long bridge across the moat — and the wagon of wounded must cross with you."},{"id":"intro-cam-2","kind":"camera","t":7.3549999999999995,"dur":2,"tx":21,"tz":40,"radius":80,"alpha":0.2,"char":"Lady"},{"id":"intro-line-3","kind":"line","t":9.355,"dur":3.025,"speaker":"Lady","text":"The wagon is slow and full of hurt. We do not leave it.","style":"command"},{"id":"intro-line-4","kind":"line","t":12.38,"dur":2.5,"speaker":"Doc","text":"Then we move together, or not at all."}]},{"id":"ending","when":"win","duration":5.3,"clips":[{"id":"ending-cam-0","kind":"camera","t":0,"dur":1.4,"tx":129,"tz":40,"radius":140,"alpha":0.1},{"id":"ending-line-1","kind":"line","t":1.4,"dur":2.5,"speaker":"Stumpey","text":"Across. The castle is behind us. All of it.","style":"whisper"},{"id":"ending-hold-2","kind":"hold","t":3.9,"dur":1.4}]}]},"obj":[[72,40,5,"escort","It cannot defend itself — keep it whole.","","Protect the wounded wagon","e1c4o0"],[129,40,6,"escape","The far bank. Freedom, for now.","/maps/e2c1.garden","Cross the moat bridge (EXIT)","e1c4o1"]],"ncb":1}