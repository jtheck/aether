:26,56:1,0:20,35:1,0:3,63:1,0:15,14:1,0:3,35:1,0:9,21:1,14:1,0:46,70:1,0:2,63:1,0:2,70:1,0:4,63:1,0:11,49:1,28:1,0:1,42:1,70:1,0:2,49:1,0:26,56:1,0:16,49:1,0:2,28:1,0:12,49:1,0:3,63:1,0:5,63:1,0:7,77:1,0:1,70:1,0:60,49:1,0:15,21:1,0:40,56:1,77:1,0:4,84:1,0:6,49:1,0:9,56:1,0:12,42:1,0:51,63:1,0:14,42:1,0:14,77:1,0:30,63:1,0:37,42:1,0:54,70:1,0:2,70:1,0:30,84:1,0:3,84:1,0:42,70:1,0:3,56:1,0:29,84:1,0:1,84:1,0:1,84:1,0:15,84:1,0:76,56:1,0:5,77:1,0:22,77:1,0:40,70:1,0:2,70:1,0:99","sr":[90,30,5,100],"story":{"reels":[{"id":"intro","when":"start","duration":23.85,"clips":[{"id":"intro-cam-0","kind":"camera","t":0,"dur":1.4,"tx":30,"tz":28,"radius":160,"alpha":-2.2},{"id":"intro-line-1","kind":"line","t":1.4,"dur":4.8950000000000005,"text":"The ancient grove shudders. A darkness creeps through the roots, twisting all it touches."},{"id":"intro-cam-2","kind":"camera","t":6.295,"dur":2.2,"tx":30,"tz":42,"radius":95,"alpha":0.35},{"id":"intro-hold-3","kind":"hold","t":8.495000000000001,"dur":0.4},{"id":"intro-line-4","kind":"line","t":8.895000000000001,"dur":2.5,"speaker":"Stumpey","text":"Big problems... we oughtta get outta here.","style":"scared"},{"id":"intro-line-5","kind":"line","t":11.395000000000001,"dur":2.915,"speaker":"Lady","text":"What is happening to the forest? I can feel it dying.","style":"whisper"},{"id":"intro-line-6","kind":"line","t":14.310000000000002,"dur":3.96,"speaker":"Doc","text":"Something has poisoned the heartwood. There is no curing this from here.","style":"think"},{"id":"intro-line-7","kind":"line","t":18.270000000000003,"dur":3.08,"speaker":"Goblin","text":"Less talking, more running! North, through the old pass!","style":"shout"},{"id":"intro-line-8","kind":"line","t":21.35,"dur":2.5,"speaker":"Stumpey","text":"Right. Stay close everyone. Move!","style":"command"}]},{"id":"ending","when":"win","duration":22.120000000000005,"clips":[{"id":"ending-cam-0","kind":"camera","t":0,"dur":1.2,"tx":30,"tz":40,"radius":100,"alpha":0.3},{"id":"ending-line-1","kind":"line","t":1.2,"dur":2.5,"speaker":"Stumpey","text":"We made it...","style":"whisper"},{"id":"ending-line-2","kind":"line","t":3.7,"dur":2.5,"speaker":"Lady","text":"But look behind us...","style":"scared"},{"id":"ending-cam-3","kind":"camera","t":6.2,"dur":2.6,"tx":30,"tz":24,"radius":145,"alpha":-2.15},{"id":"ending-line-4","kind":"line","t":8.8,"dur":2.53,"speaker":"Doc","text":"All those towers... everything we built. Gone.","style":"think"},{"id":"ending-hold-5","kind":"hold","t":11.33,"dur":0.8},{"id":"ending-line-6","kind":"line","t":12.13,"dur":2.5,"speaker":"Goblin","text":"No use cryin' about it. What's ahead?"},{"id":"ending-line-7","kind":"line","t":14.63,"dur":2.5,"speaker":"Stumpey","text":"The old road. Nobody's used it in ages."},{"id":"ending-line-8","kind":"line","t":17.130000000000003,"dur":3.19,"text":"The party turns north, leaving the corrupted grove behind."},{"id":"ending-hold-9","kind":"hold","t":20.320000000000004,"dur":1.8}]}]},"lt":{"e":2.15,"c":1.3,"k":[0.27,0.45,0.66],"b":[["sun",56,36,1.85],["hemi",236,68,0.34]]},"ncb":1,"mt":"adventure","pk":{"files":["chapter1.garden","chapter2.garden","chapter3.garden","Chapter_6.garden","Chapter_4.garden"]}},"Chapter_5.garden":{"v":4,"n":"Chapter 1","w":80,"h":80,"s":3475582729,"cs":16,"cm":"1111111111111111111111111","rr":"0:25","t":"3:3,2:6,3:3,2:9,3:9,2:2,3:4,1:29,3:3,2:1,3:4,1:2,3:4,2:1,3:3,2:6,3:5,2:6,3:2,1:4,3:3,2:4,3:2,1:32,3:1,2:1,3:3,1:4,3:3,2:1,3:4,2:5,3:5,2:5,3:3,1:4,3:3,2:5,3:1,1:32,3:1,2:1,3:3,1:4,3:3,2:1,1:1,3:4,2:4,3:4,2:5,3:4,1:3,3:4,2:5,3:1,1:32,3:4,1:5,3:3,2:1,3:8,2:9,3:13,2:4,3:2,1:32,3:3,1:5,3:12,2:7,3:16,2:4,3:1,1:32,3:2,1:2,3:10,1:3,3:4,2:6,3:16,2:4,3:2,1:34,3:11,1:4,3:3,2:6,3:17,2:4,3:2,1:33,3:11,1:4,3:3,2:5,3:9,2:3,3:5,2:6,3:1,1:33,3:11,1:4,3:4,2:4,3:8,2:5,3:4,2:6,3:2,1:31,3:13,1:2,3:17,2:16,3:1,1:31,3:33,2:15,3:2,1:30,3:19,1:3,3:5,2:5,3:2,2:11,3:5,1:30,3:18,1:6,3:3,2:17,3:6,1:31,3:8,2:1,3:8,1:6,3:3,2:17,3:7,1:30,3:7,2:2,3:7,1:7,3:3,2:16,3:8,1:30,3:8,2:1,3:7,1: