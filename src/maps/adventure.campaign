ker":"Goblin","text":"Less talking, more running! North, through the old pass!","style":"shout"},{"id":"intro-line-8","kind":"line","t":21.35,"dur":2.5,"speaker":"Stumpey","text":"Right. Stay close everyone. Move!","style":"command"}]},{"id":"ending","when":"win","duration":22.120000000000005,"clips":[{"id":"ending-cam-0","kind":"camera","t":0,"dur":1.2,"tx":30,"tz":40,"radius":100,"alpha":0.3},{"id":"ending-line-1","kind":"line","t":1.2,"dur":2.5,"speaker":"Stumpey","text":"We made it...","style":"whisper"},{"id":"ending-line-2","kind":"line","t":3.7,"dur":2.5,"speaker":"Lady","text":"But look behind us...","style":"scared"},{"id":"ending-cam-3","kind":"camera","t":6.2,"dur":2.6,"tx":30,"tz":24,"radius":145,"alpha":-2.15},{"id":"ending-line-4","kind":"line","t":8.8,"dur":2.53,"speaker":"Doc","text":"All those towers... everything we built. Gone.","style":"think"},{"id":"ending-hold-5","kind":"hold","t":11.33,"dur":0.8},{"id":"ending-line-6","kind":"line","t":12.13,"dur":2.5,"speaker":"Goblin","text":"No use cryin' about it. What's ahead?"},{"id":"ending-line-7","kind":"line","t":14.63,"dur":2.5,"speaker":"Stumpey","text":"The old road. Nobody's used it in ages."},{"id":"ending-line-8","kind":"line","t":17.130000000000003,"dur":3.19,"text":"The party turns north, leaving the corrupted grove behind."},{"id":"ending-hold-9","kind":"hold","t":20.320000000000004,"dur":1.8}]}]},"lt":{"e":2.15,"c":1.3,"k":[0.27,0.45,0.66],"b":[["sun",56,36,1.85],["hemi",236,68,0.34]]},"ncb":1,"mt":"adventure","pk":{"files":["chapter1.garden","chapter2.garden","chapter3.garden","Chapter_6.garden","Chapter_4.garden"]}},"Chapter_4.garden":{"v":4,"n":"Chapter 1","w":80,"h":80,"s":1728332451,"cs":16,"cm":"1111111111111111111111111","rr":"0:25","t":"2:12,3:11,2:8,3:12,1:2,3:11,1:10,3:1,2:2,3:2,1:9,2:13,3:9,2:11,3:24,1:8,3:2,2:2,3:1,1:10,2:13,3:5,2:5,3:6,2:5,3:15,1:7,3:4,1:4,3:2,2:3,3:1,1:10,2:14,3:3,2:6,3:7,2:5,3:13,1:8,3:4,1:4,3:1,2:4,3:1,1:10,2:15,3:1,2:1,3:3,2:3,3:7,2:5,3:13,1:9,3:4,1:2,3:2,