4:1,142:1,140:9","u":[[0,5,30,44,"Stumpey"],[0,3,27,44,"Goblin"],[0,4,30,42,"Lady"],[0,6,33,42,"Doc"]],"g":[[0,-38,14]],"story":{"reels":[{"id":"intro","when":"start","duration":24.4,"clips":[{"id":"intro-cam-0","kind":"camera","t":0,"dur":0.05,"tx":30,"tz":18,"radius":200,"alpha":-2.5},{"id":"intro-line-1","kind":"line","t":0.05,"dur":4.8950000000000005,"text":"The ancient grove shudders. A darkness creeps through the roots, twisting all it touches."},{"id":"intro-cam-2","kind":"camera","t":4.945,"dur":4,"tx":30,"tz":43,"radius":45,"alpha":0.6416,"char":"Stumpey"},{"id":"intro-hold-3","kind":"hold","t":8.945,"dur":0.5},{"id":"intro-line-4","kind":"line","t":9.445,"dur":2.5,"speaker":"Stumpey","text":"Big problems... we oughtta get outta here.","style":"scared"},{"id":"intro-line-5","kind":"line","t":11.945,"dur":2.915,"speaker":"Lady","text":"What is happening to the forest? I can feel it dying.","style":"whisper"},{"id":"intro-line-6","kind":"line","t":14.86,"dur":3.96,"speaker":"Doc","text":"Something has poisoned the heartwood. There is no curing this from here.","style":"think"},{"id":"intro-line-7","kind":"line","t":18.82,"dur":3.08,"speaker":"Goblin","text":"Less talking, more running! North, through the old pass!","style":"shout"},{"id":"intro-line-8","kind":"line","t":21.9,"dur":2.5,"speaker":"Stumpey","text":"Right. Stay close everyone. Move!","style":"command"}]},{"id":"ending","when":"win","duration":20.07,"clips":[{"id":"ending-cam-0","kind":"camera","t":0,"dur":0.05,"tx":30,"tz":11,"radius":50,"alpha":0},{"id":"ending-line-1","kind":"line","t":0.05,"dur":2.5,"speaker":"Stumpey","text":"We made it...","style":"whisper"},{"id":"ending-line-2","kind":"line","t":2.55,"dur":2.5,"speaker":"Lady","text":"But look behind us...","style":"scared"},{"id":"ending-cam-3","kind":"camera","t":5.05,"dur":1.7,"tx":18,"tz":35,"radius":120,"alpha":0},{"id":"ending-line-4","kind":"line","t":6.75,"dur":2.53,"speaker":"Doc","text":"All those towers... everything we built. Gone.","style":"think"},{"id":"ending-hold-5","kind":"hold","t":9.28,"dur":1},{"id":"ending-line-6","kind":"line","t":10.28,"dur":2.5,"speaker":"Goblin","text":"No use cryin' about it. What's ahead?"},{"id":"ending-cam-7","kind":"camera","t":12.78,"dur":1.6,"tx":30,"tz":5,"radius":80,"alpha":0},{"id":"ending-line-8","kind":"line","t":14.379999999999999,"dur":2.5,"speaker":"Stumpey","text":"The old road. Nobody's used it in ages."},{"id":"ending-line-9","kind":"line","t":16.88,"dur":3.19,"text":"The party turns north, leaving the corrupted grove behind."}]}]}}